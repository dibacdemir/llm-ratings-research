# Model outputs and everything built from them are regenerable (./ratings run,
# ./ratings show). Only the page templates and the folder's README are source.
result/*
!result/README.md
!result/inspector_template.html
!result/report_template.html

# metadata/ figures and catalog are generated by pipeline/build_metadata.py,
# but small and worth versioning, so they are NOT ignored.

__pycache__/
*.pyc
.DS_Store
**/.DS_Store
__MACOSX/
